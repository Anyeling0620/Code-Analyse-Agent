# 本地配置与密钥（含真实 API key，禁止入库）
agent_code_local.yml
# 改配置前的手工备份同样含密钥；只忽略精确文件名会让 .bak-* 被 IDE 自动暂存进仓库
agent_code_local.yml.*

# 构建产物
main
main.exe
*.exe
web/dist

# 运行时数据与日志
data/edu.agent.code.db
data/code_index.db*
logs/

# 依赖与编辑器
web/node_modules
.idea
.claude
.ai-memory

# 内部资料（不随仓库分发）
docs
scripts
deploy
spec
# 例外：CI 构建链需要它生成 Release 说明，必须随仓库分发。
# （! 规则要求父目录未被整体排除，所以先放行 scripts 目录本身，再逐项忽略其它脚本。）
!scripts/
scripts/*
!scripts/release-notes.sh

# Agent 工作区与任务临时文件
workspace
.codex_tasks


# 评测产物：可由 `go run ./eval/rag` 重跑生成，不入库
eval/**/results*.json
eval/**/collection_index*.json

# 临时程序（建索引/探测用，用完即删）
tmp_unseen_index/
